# Copy to .env before running anything: cp .env.example .env
# .env is gitignored. These defaults are fine for local development.

# Postgres login and database name. Docker Compose creates the database with
# these. On Coolify, SERVICE_* variables are generated for you per environment.
SERVICE_USER_POSTGRES=app
SERVICE_PASSWORD_POSTGRES=app
POSTGRES_DB=app

# Port Postgres is published on at localhost. Change it if something else on
# your machine already uses 5432, and change it in DATABASE_URL below too.
POSTGRES_PORT=5432

# Used by commands you run on your machine (mise run db:migrate, db:revision),
# which reach Postgres through the port above. The backend container builds
# its own URL from the values above.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
