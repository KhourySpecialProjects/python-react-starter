# Force LF everywhere. Files are executed inside Linux containers;
# CRLF line endings from Windows checkouts break shell scripts and config.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Generated from the backend's contract. Collapsed in GitHub diffs.
frontend/src/client/** linguist-generated=true
backend/openapi.json linguist-generated=true
